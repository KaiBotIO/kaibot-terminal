{
  "name": "kaibot-executor",
  "private": true,
  "license": "AGPL-3.0-only",
  "version": "0.4.18",
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "dev:frontend": "vite",
    "dev:web": "bun scripts/dev-web-multi.js",
    "test:instance": "bun test-instance.mjs",
    "dev:web:old": "concurrently \"bun run dev:backend\" \"vite\"",
    "dev:backend": "cd node-backend && bun run dev",
    "build": "bun run build:backend && bun run build:web",
    "build:desktop": "bun run build:backend && tauri build",
    "build:backend": "cd node-backend && bun run build",
    "build:web": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "bun test --path-ignore-patterns='node-backend/**'",
    "test:web": "vitest run"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.2.9",
    "@fontsource-variable/geist-mono": "^5.2.8",
    "@hookform/resolvers": "^5.1.1",
    "@kaibot/design-system": "workspace:*",
    "@kaibot/shared": "workspace:*",
    "@kaibot/terminal-bridge": "workspace:*",
    "@kaibot/types": "workspace:*",
    "@radix-ui/react-tooltip": "^1.2.7",
    "@tauri-apps/api": "^2.6.0",
    "@tauri-apps/plugin-notification": "~2",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "^2",
    "@tauri-apps/plugin-updater": "^2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jotai": "^2.12.5",
    "lucide-react": "^1.0.1",
    "nucleo-core-outline-32": "^1.1.3",
    "react": "^19",
    "react-dom": "^19",
    "react-hook-form": "^7.60.0",
    "react-router-dom": "^7.6.2",
    "recharts": "2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.16",
    "@tauri-apps/cli": "^2.6.2",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/bun": "^1.0.0",
    "@types/node": "^24.0.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react-swc": "^3.8.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.1.2",
    "jsdom": "^25.0.1",
    "postcss": "^8.5.6",
    "tailwindcss": "3.4.0",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "~5.6.2",
    "vite": "^6.0.3",
    "vitest": "^2.1.9"
  }
