# Required by the e2e suites that exercise the real API ack route/relay
# (e2e-signal-chain, e2e-companion-control) — same dev Postgres as apps/api.
DATABASE_URL=postgresql://postgres:postgres@localhost:5434/kaibot

# Optional: signal service session token (MVP shortcut)
EXECUTOR_SESSION_TOKEN=tradestation:user@email.com

# TradeStation — read access_token from legacy KaiBotWeb CouchDB session.
# When all three are set, the executor auto-connects TradeStation at startup.
COUCHDB_URL=https://user:pass@couchdb.example.com:6984
COUCHDB_SESSION_DB=user-sessions
COUCHDB_TS_SESSION_ID=tradestation%3Auser%40email.com
TS_TESTNET=false

# Breathing-room margin guard — built-in defaults (per-account config in the UI
# overrides these; the Settings → Margin Guard tab writes per-(exchange,account)
# rows + a global default). All optional.
# Default-on for accounts without a row (false = opt-in).
BREATHING_ROOM_ENABLED=false
# Keep this multiple of the floor free as margin after every open.
BREATHING_ROOM_MULT=1.0
# Floor basis: maintenance | initial | equityPct
BREATHING_ROOM_FLOOR_MODE=maintenance
# Fraction of equity used as the floor when floor mode = equityPct (0..1).
BREATHING_ROOM_EQUITY_PCT=0.2
# Leverage assumed for a new order when no position reveals it (1 = full notional).
BREATHING_ROOM_DEFAULT_LEVERAGE=1
