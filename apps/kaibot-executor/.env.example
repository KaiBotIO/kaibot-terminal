# Canonical KaiBot app origin. API/account, legal pages and the online terminal
# all derive from this by default — set it once here. PLACEHOLDER domain; point
# it at the real deployed app before shipping.
VITE_KAIBOT_APP_URL=https://app.kaibot.io

# API base URL for backend services
VITE_API_URL=http://localhost:9100

# Optional overrides. When unset they fall back to VITE_KAIBOT_APP_URL above
# (or, with no vars set at all, to the prod api.kaibot.io / app.kaibot.io).

# API/account origin the executor authenticates against. Prod is split:
# api.kaibot.io is the API, app.kaibot.io serves static assets only.
VITE_KAIBOT_API_URL=https://api.kaibot.io

# ONLINE terminal (apps/frontend) embedded in the executor /terminal page.
# The TV Charting Library stays served from this origin (licence) — it is never
# bundled into the executor. Its origin is also the postMessage targetOrigin /
# inbound allowlist.
VITE_ONLINE_TERMINAL_URL=https://app.kaibot.io
